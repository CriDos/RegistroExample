# Auto-detect text files and normalize line endings
* text=auto

# Source code and configuration files: enforce LF in repo and working tree
*.cpp text eol=lf
*.h text eol=lf
*.qml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.clang-format text eol=lf

# Windows batch scripts must always have CRLF endings
*.cmd text eol=crlf
*.bat text eol=crlf

